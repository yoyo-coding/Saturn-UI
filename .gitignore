# -----------------------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.url
[Bb]ackup*/
*.[Bb]ak
*.orig
*.tmp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# 本地构建 / 用户配置
# -----------------------------------------------------------------------------
*.local
*.local.json
appsettings.*.local.json
secrets.json
appsettings.Development.json

# 数据库 / 缓存数据 (Saturn UI 用 LiteDB 存储会话)
*.ldb
*.sqlite
*.sqlite3
*.db
*.db3
Data/
storage/
sessions.db
*.localstorage

# 日志
*.log
*.log.*

# 临时文件
tmp/
temp/
.cache/
.tmp/
*.tmp
*.temp

