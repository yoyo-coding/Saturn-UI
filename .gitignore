# =============================================================================
# Saturn UI .gitignore
# Avalonia / .NET desktop project hygiene
# -----------------------------------------------------------------------------
# Keep repository focused on source code plus README and LICENSE.
# Root-level project plans, implementation notes, screenshots, IDE state,
# local Codex/Trae files, build outputs, caches and runtime data are ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Repository root: keep only project/source essentials
# -----------------------------------------------------------------------------
# Root-level documents: only README and LICENSE should be kept in the repo.
/*.md
!/README.md
!/REFACTOR_REPORT.md
!/readme.md
!/REFACTOR_REPORT.md
!/Readme.md
!/REFACTOR_REPORT.md
!/LICENSE.md
!/license.md
!/License.md
!/LICENSE
!/license
!/License

# Explicit root project/implementation plans and local planning folders.
/Plan.md
/Implementation.md
/.trae/
/.codex/

# Root-level documents / notes / office exports.
/*.txt
/*.rtf
/*.doc
/*.docx
/*.pdf
/*.ppt
/*.pptx
/*.xls
/*.xlsx
/*.csv

# Root-level archives / temporary deliverables.
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz

# Root-level screenshots / design exports / throwaway assets.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.bmp
/*.tiff
/*.svg

# Local build/package artifacts at repository root.
/artifacts/
/out/
/publish/

# -----------------------------------------------------------------------------
# .NET / C# build outputs
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
bin/
obj/
out/
publish/
artifacts/

# Compiled binaries and symbols
*.dll
*.exe
*.pdb
*.so
*.dylib
*.dll.config
*.exe.config
*.exe.mdb
*.dll.mdb
*.apphost

# Build configurations and generated folders
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# -----------------------------------------------------------------------------
# NuGet / package restore
# -----------------------------------------------------------------------------
*.nupkg
*.snupkg
.nuget/
packages/
*.nupkg.info
*.nupkg.spec
project.lock.json
project.fragment.lock.json
*.lock.json

# -----------------------------------------------------------------------------
# Visual Studio / Rider / VS Code / editor state
# -----------------------------------------------------------------------------
.idea/
.vs/
.vscode/
*.sln.iml
*.csproj.iml
*.user
*.suo
*.userprefs
*.sln.docstates
*.userosscache
*.sln.ide
*.csproj.user
*.csproj.user.*
*.swp
*.swo

# -----------------------------------------------------------------------------
# Avalonia generated/cache files
# -----------------------------------------------------------------------------
Avalonia.Generators.Compiled.dll
Generated/Pages/
.generated/
.designer/
Designer.avalonia
*.cache
Resources.Inputs.cache
*.resources.cache

# -----------------------------------------------------------------------------
# Test results / coverage
# -----------------------------------------------------------------------------
TestResults/
[Tt]est[Rr]esult*/
*.testsettings
*.vsmdi
*.trx
*.testlog
*.coverage
*.coveragexml
.coverage
.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.cover
*.cover.xml
*.coverage.html
*.coverage.xml

# -----------------------------------------------------------------------------
# Local runtime configuration / secrets
# -----------------------------------------------------------------------------
*.local
*.local.json
appsettings.*.local.json
appsettings.Development.json
secrets.json
.env
.env.*
*.key
*.pem

# -----------------------------------------------------------------------------
# Local databases / cache data / Saturn UI runtime state
# -----------------------------------------------------------------------------
*.ldb
*.sqlite
*.sqlite3
*.db
*.db3
Data/
storage/
sessions.db
*.localstorage
.cache/
.tmp/
tmp/
temp/
*.tmp
*.temp

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
*.log.*

# -----------------------------------------------------------------------------
# OS generated files
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.url
[Bb]ackup*/
*.[Bb]ak
*.orig

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

