<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaturnUI.ViewModels"
        xmlns:converters="using:SaturnUI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:SaturnUI.Views"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SaturnUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Saturn UI - 灵星"
        Background="{DynamicResource M3Surface}"
        Foreground="{DynamicResource M3OnSurface}"
        MinWidth="800" MinHeight="600"
        Width="1200" Height="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsSessionPanelOpen, Converter={x:Static converters:BoolConverters.StarGridLength}, ConverterParameter=260, FallbackValue=260}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Session Panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource M3SurfaceContainerLow}"
                BorderBrush="{DynamicResource M3OutlineVariant}"
                BorderThickness="0,0,1,0"
                IsVisible="{Binding IsSessionPanelOpen}">
            <views:SessionListView DataContext="{Binding SessionListViewModel}" />
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Top App Bar (M3 顶栏) -->
            <Border Grid.Row="0" Classes="TopAppBar">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Menu / Navigation Icon -->
                    <Button Grid.Column="0"
                            Classes="Icon"
                            Command="{Binding ToggleSessionPanelCommand}"
                            ToolTip.Tip="切换会话列表">
                        <materialIcons:MaterialIcon Kind="Menu" Width="24" Height="24" />
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ChatViewModel.StatusText}"
                               Classes="BodyLarge"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               Foreground="{DynamicResource M3OnSurfaceVariant}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4">
                        <Button Classes="Icon"
                                Command="{Binding NewChatCommand}"
                                ToolTip.Tip="新会话">
                            <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24" />
                        </Button>
                        <Button Classes="Icon"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="设置">
                            <materialIcons:MaterialIcon Kind="Cog" Width="24" Height="24" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Area -->
            <views:ChatView Grid.Row="1"
                            DataContext="{Binding ChatViewModel}" />
        </Grid>

        <!-- Settings Panel -->
        <Border Grid.Column="1"
                Background="{DynamicResource M3Background}"
                IsVisible="{Binding IsSettingsOpen}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="TopAppBar">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="设置"
                                   Classes="HeadlineSmall"
                                   VerticalAlignment="Center"
                                   Margin="8,0" />
                        <Button Grid.Column="1"
                                Classes="Icon"
                                Command="{Binding CloseSettingsCommand}"
                                ToolTip.Tip="关闭">
                            <materialIcons:MaterialIcon Kind="Close" Width="24" Height="24" />
                        </Button>
                    </Grid>
                </Border>
                <views:SettingsView Grid.Row="1"
                                    DataContext="{Binding SettingsViewModel}" />
            </Grid>
        </Border>
    </Grid>
</Window>
