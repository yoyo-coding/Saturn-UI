<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaturnUI.ViewModels"
        xmlns:converters="using:SaturnUI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:SaturnUI.Views"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:controls="using:SaturnUI.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="SaturnUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Saturn UI - 灵星"
        Background="{DynamicResource M3Surface}"
        Foreground="{DynamicResource M3OnSurface}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        MinWidth="860" MinHeight="620"
        Width="1280" Height="820">

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource M3Background}">
        <Border Grid.Row="0"
                Classes="TitleBar"
                Height="56"
                Padding="12,0,8,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Background="Transparent"
                        Padding="4,0,18,0"
                        PointerPressed="OnTitleBarPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="12"
                                Background="{DynamicResource M3PrimaryContainer}">
                            <materialIcons:MaterialIcon Kind="Planet"
                                                        Width="20" Height="20"
                                                        Foreground="{DynamicResource M3OnPrimaryContainer}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="Saturn UI" Classes="TitleSmall" />
                            <TextBlock Text="Material 3"
                                       Classes="LabelSmall Muted" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="Transparent"
                        PointerPressed="OnTitleBarPointerPressed">
                    <TextBlock Text="{Binding ChatViewModel.StatusText}"
                               Classes="BodySmall Muted"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <controls:RippleButton Classes="Icon WindowControl"
                            Click="OnMinimizeClick"
                            ToolTip.Tip="最小化">
                        <TextBlock Text="—"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </controls:RippleButton>
                    <controls:RippleButton Classes="Icon WindowControl"
                            Click="OnMaximizeRestoreClick"
                            ToolTip.Tip="最大化/还原">
                        <TextBlock x:Name="MaximizeRestoreGlyph"
                                   Text="□"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </controls:RippleButton>
                    <controls:RippleButton Classes="Icon WindowControl WindowClose"
                            Click="OnCloseClick"
                            ToolTip.Tip="关闭">
                        <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" />
                    </controls:RippleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource M3Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSessionPanelOpen, Converter={x:Static converters:BoolConverters.StarGridLength}, ConverterParameter=292, FallbackValue=292}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="12,0,0,12"
                    Classes="NavigationRail"
                    CornerRadius="28"
                    BorderBrush="{DynamicResource M3OutlineVariant}"
                    BorderThickness="1"
                    IsVisible="{Binding IsSessionPanelOpen}">
                <views:SessionListView DataContext="{Binding SessionListViewModel}" />
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="12,0,12,12">
                <Border Grid.Row="0"
                        Classes="TopAppBar"
                        CornerRadius="28"
                        BorderBrush="{DynamicResource M3OutlineVariant}"
                        BorderThickness="1"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <controls:RippleButton Grid.Column="0"
                                Classes="Icon"
                                Command="{Binding ToggleSessionPanelCommand}"
                                ToolTip.Tip="切换会话列表">
                            <materialIcons:MaterialIcon Kind="Menu" Width="24" Height="24" />
                        </controls:RippleButton>

                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="聊天工作台" Classes="TitleMedium" />
                            <TextBlock Text="{Binding ChatViewModel.StatusText}"
                                       Classes="BodySmall Muted"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <controls:RippleButton Classes="Icon"
                                    Command="{Binding OpenSettingsCommand}"
                                    ToolTip.Tip="设置">
                                <materialIcons:MaterialIcon Kind="Cog" Width="22" Height="22" />
                            </controls:RippleButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="Card Filled" Padding="0" ClipToBounds="True">
                    <views:ChatView DataContext="{Binding ChatViewModel}" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                ZIndex="10"
                Background="#99000000"
                IsVisible="{Binding IsSettingsOpen}">
            <Border Width="520"
                    HorizontalAlignment="Right"
                    Margin="16"
                    Classes="Card Filled"
                    Padding="0"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="TopAppBar" Padding="20,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="设置中心" Classes="TitleLarge" />
                                <TextBlock Text="模型、外观与运行策略" Classes="BodySmall Muted" />
                            </StackPanel>
                            <controls:RippleButton Grid.Column="1"
                                    Classes="Icon"
                                    Command="{Binding CloseSettingsCommand}"
                                    ToolTip.Tip="关闭设置">
                                <materialIcons:MaterialIcon Kind="Close" Width="24" Height="24" />
                            </controls:RippleButton>
                        </Grid>
                    </Border>
                    <views:SettingsView Grid.Row="1" DataContext="{Binding SettingsViewModel}" />
                </Grid>
            </Border>
        </Border>

        <Border x:Name="SplashOverlay"
                Grid.Row="0"
                Grid.RowSpan="2"
                ZIndex="99"
                Background="{DynamicResource M3Background}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <Border Width="420"
                        Height="420"
                        CornerRadius="210"
                        Opacity="0.22"
                        Background="{DynamicResource M3PrimaryContainer}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                    <Border Width="148" Height="148" CornerRadius="42"
                            Background="{DynamicResource M3SurfaceContainerHighest}"
                            BorderBrush="{DynamicResource M3OutlineVariant}"
                            BorderThickness="1">
                        <Image x:Name="SplashImage" Width="112" Height="112"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Saturn UI"
                                   Classes="DisplaySmall"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="正在装载 Material 3 聊天工作台"
                                   Classes="BodyMedium Muted"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
