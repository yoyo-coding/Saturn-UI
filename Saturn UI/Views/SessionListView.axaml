<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             xmlns:models="using:SaturnUI.Models"
             x:Class="SaturnUI.Views.SessionListView"
             x:DataType="vm:SessionListViewModel"
             x:Name="RootView">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource LynSurfaceBrush}"
                BorderBrush="{DynamicResource LynBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="会话"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource LynTextBrush}" />
                <Button Grid.Column="1"
                        Command="{Binding NewSessionCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                              Foreground="{DynamicResource LynPrimaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Search -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="12,8">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     Watermark="搜索会话..."
                     Background="{DynamicResource LynBackgroundBrush}"
                     Foreground="{DynamicResource LynTextBrush}"
                     BorderBrush="{DynamicResource LynBorderBrush}"
                     CornerRadius="6"
                     Padding="8,6" />
            <Button Grid.Column="1"
                    Command="{Binding SearchSessionsCommand}"
                    Margin="4,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6">
                <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Foreground="{DynamicResource LynSubTextBrush}" />
            </Button>
        </Grid>

        <!-- Session List -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Sessions}"
                 SelectedItem="{Binding SelectedSession}"
                 SelectionMode="Single"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="8,0"
                 SelectionChanged="SessionsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Session">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource LynTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource LynSubTextBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{ReflectionBinding #RootView.DataContext.DeleteSessionCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4"
                                Opacity="0.6">
                            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                      Width="14"
                                      Height="14"
                                      Foreground="{DynamicResource LynSubTextBrush}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
