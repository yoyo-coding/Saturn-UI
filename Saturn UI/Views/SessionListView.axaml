<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             xmlns:models="using:SaturnUI.Models"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:controls="using:SaturnUI.Controls"
             x:Class="SaturnUI.Views.SessionListView"
             x:DataType="vm:SessionListViewModel"
             x:Name="RootView">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header (M3 Top App Bar) -->
        <Border Grid.Row="0" Classes="TopAppBar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="会话"
                           Classes="TitleLarge"
                           VerticalAlignment="Center" />
                <controls:RippleButton Grid.Column="1"
                        Classes="Icon"
                        Command="{Binding NewSessionCommand}"
                        ToolTip.Tip="新建会话">
                    <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24" />
                </controls:RippleButton>
            </Grid>
        </Border>

        <!-- Search (M3 Search Bar) - 实时过滤,通过 OnSearchTextChanged 触发 -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="16,8">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     Watermark="搜索会话..." />
            <materialIcons:MaterialIcon Grid.Column="1"
                                        Kind="Magnify"
                                        Width="20" Height="20"
                                        Margin="12,0,8,0"
                                        Foreground="{DynamicResource M3OnSurfaceVariant}" />
        </Grid>

        <!-- Session List - 使用 ItemsControl + RippleSelectableItem(确保涟漪) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:Session">
                        <controls:RippleSelectableItem
                            IsSelected="{Binding $parent[ItemsControl].((vm:SessionListViewModel)DataContext).SelectedSession, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={Binding}, Mode=TwoWay}"
                            Command="{Binding $parent[ItemsControl].((vm:SessionListViewModel)DataContext).SelectSessionCommand}"
                            CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               Classes="TitleMedium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                               Classes="BodySmall"
                                               Foreground="{DynamicResource M3OnSurfaceVariant}" />
                                </StackPanel>
                                <controls:RippleButton Grid.Column="1"
                                        Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((vm:SessionListViewModel)DataContext).DeleteSessionCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="删除会话"
                                        Opacity="0.7">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" />
                                </controls:RippleButton>
                            </Grid>
                        </controls:RippleSelectableItem>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
