<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             xmlns:models="using:SaturnUI.Models"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:controls="using:SaturnUI.Controls"
             x:Class="SaturnUI.Views.SessionListView"
             x:DataType="vm:SessionListViewModel"
             x:Name="RootView">

    <Grid RowDefinitions="Auto,Auto,*" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="4,4,4,12">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="16"
                    Background="{DynamicResource M3PrimaryContainer}">
                <materialIcons:MaterialIcon Kind="Planet"
                                            Width="24" Height="24"
                                            Foreground="{DynamicResource M3OnPrimaryContainer}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="会话" Classes="TitleLarge" />
                <TextBlock Text="历史记录与草稿" Classes="BodySmall Muted" />
            </StackPanel>
            <controls:RippleButton Grid.Column="2"
                    Classes="Fab"
                    Command="{Binding NewSessionCommand}"
                    ToolTip.Tip="新建会话">
                <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24" />
            </controls:RippleButton>
        </Grid>

        <Border Grid.Row="1"
                CornerRadius="8"
                Padding="12,4"
                Margin="4,0,4,12"
                Background="{DynamicResource M3SurfaceContainerHigh}"
                BorderBrush="{DynamicResource M3OutlineVariant}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*">
                <materialIcons:MaterialIcon Grid.Column="0"
                                            Kind="Magnify"
                                            Width="20" Height="20"
                                            Foreground="{DynamicResource M3OnSurfaceVariant}"
                                            VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Classes="Flat"
                         Text="{Binding SearchText}"
                         Watermark="搜索会话..."
                         Margin="8,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:Session">
                        <controls:RippleSelectableItem
                            Classes="SessionItem"
                            IsSelected="{Binding IsSelected, Mode=OneWay}"
                            Command="{Binding $parent[ItemsControl].((vm:SessionListViewModel)DataContext).SelectSessionCommand}"
                            CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="2">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Title}"
                                           Classes="TitleSmall"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           Classes="BodySmall Muted"
                                           Margin="0,4,0,0" />
                                <controls:RippleButton Grid.RowSpan="2" Grid.Column="1"
                                        Classes="Icon"
                                        Command="{Binding $parent[ItemsControl].((vm:SessionListViewModel)DataContext).DeleteSessionCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="删除会话"
                                        Opacity="0.76">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" />
                                </controls:RippleButton>
                            </Grid>
                        </controls:RippleSelectableItem>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
