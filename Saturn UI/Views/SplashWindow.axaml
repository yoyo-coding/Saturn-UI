<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SaturnUI.Views.SplashWindow"
        WindowState="FullScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        CanResize="False"
        Background="{DynamicResource M3Background}">
    <Grid x:Name="RootGrid">
        <Border Width="460" Height="460" CornerRadius="16"
                Opacity="0.20"
                Background="{DynamicResource M3PrimaryContainer}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
            <Border Width="150" Height="150" CornerRadius="16"
                    Background="{DynamicResource M3SurfaceContainerHighest}"
                    BorderBrush="{DynamicResource M3OutlineVariant}"
                    BorderThickness="1">
                <Image x:Name="SplashImage" Width="112" Height="112"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock x:Name="SplashText"
                           Text="Saturn UI"
                           Classes="DisplaySmall"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Material 3 智能对话工作台"
                           Classes="BodyMedium Muted"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
