<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             xmlns:models="using:SaturnUI.Models"
             xmlns:converters="using:SaturnUI.Converters"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:controls="using:SaturnUI.Controls"
             x:Class="SaturnUI.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Grid RowDefinitions="*,Auto">
        <!-- Messages List -->
        <ScrollViewer Grid.Row="0"
                      Name="MessagesScroll"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,8"
                      Background="{DynamicResource M3Background}">
            <ItemsControl ItemsSource="{Binding Messages}"
                          Margin="16,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:Message">
                        <Border Margin="0,4"
                                Classes="msg"
                                Classes.user="{Binding IsUser}"
                                CornerRadius="16"
                                Padding="16,12"
                                MaxWidth="800"
                                HorizontalAlignment="{Binding Role, Converter={StaticResource RoleAlignmentConverter}}">
                            <StackPanel>
                                <!-- User message: plain text -->
                                <TextBlock IsVisible="{Binding IsUser}"
                                           Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           Classes="BodyLarge" />

                                <!-- Assistant message: Markdown -->
                                <md:MarkdownScrollViewer IsVisible="{Binding IsAssistant}"
                                                         Markdown="{Binding Content}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         MaxWidth="768">
                                    <md:MarkdownScrollViewer.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource M3OnSurface}" />
                                        </Style>
                                        <Style Selector="Border.CodeBlock">
                                            <Setter Property="Background" Value="{DynamicResource M3CodeBackground}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource M3CodeBorder}" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                        <Style Selector="Border.Blockquote">
                                            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainer}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource M3Primary}" />
                                        </Style>
                                    </md:MarkdownScrollViewer.Styles>
                                </md:MarkdownScrollViewer>

                                <!-- Image Attachment -->
                                <Border IsVisible="{Binding IsImageAttachment}"
                                        Margin="0,8,0,0"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        MaxWidth="400"
                                        MaxHeight="300"
                                        HorizontalAlignment="Left">
                                    <Image Source="{Binding AttachmentPath}"
                                           Stretch="Uniform" />
                                </Border>

                                <!-- File Attachment (non-image) -->
                                <StackPanel IsVisible="{Binding HasAttachment}"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline"
                                                                Width="16"
                                                                Height="16"
                                                                Foreground="{DynamicResource M3OnSurfaceVariant}" />
                                    <TextBlock Text="{Binding AttachmentName}"
                                               Foreground="{DynamicResource M3OnSurfaceVariant}"
                                               Classes="BodySmall"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsError}"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{DynamicResource M3Error}"
                                               TextWrapping="Wrap"
                                               Classes="BodySmall" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsStreaming}"
                                            Margin="0,4,0,0"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                    <Border Width="6" Height="14" Background="{DynamicResource M3Primary}" CornerRadius="3" />
                                    <Border Width="6" Height="14" Background="{DynamicResource M3Primary}" Opacity="0.7" CornerRadius="3" />
                                    <Border Width="6" Height="14" Background="{DynamicResource M3Primary}" Opacity="0.4" CornerRadius="3" />
                                </StackPanel>
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                           Classes="LabelSmall"
                                           Foreground="{DynamicResource M3OnSurfaceVariant}"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area (M3 Bottom App Bar / Search Bar) -->
        <Border Grid.Row="1"
                Background="{DynamicResource M3SurfaceContainer}"
                BorderBrush="{DynamicResource M3OutlineVariant}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Pending Attachment -->
                <Border Grid.Row="0"
                        IsVisible="{Binding PendingAttachmentName, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Classes="Card Filled"
                        Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <materialIcons:MaterialIcon Kind="FileDocumentOutline"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="{DynamicResource M3OnSurfaceVariant}" />
                            <TextBlock Text="{Binding PendingAttachmentName}"
                                       Foreground="{DynamicResource M3OnSurfaceVariant}"
                                       Classes="BodySmall"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:RippleButton Grid.Column="1"
                                Classes="Icon"
                                Command="{Binding ClearAttachmentCommand}"
                                Padding="4">
                            <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                        </controls:RippleButton>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0"
                         Text="{Binding InputText}"
                         Watermark="输入消息... (Shift+Enter 换行, Ctrl+Enter 发送)"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="120"
                         VerticalContentAlignment="Top">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Ctrl+Enter"
                                    Command="{Binding SendMessageCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                    <controls:RippleButton Grid.Column="1"
                            Classes="FilledTonal Icon"
                            Command="{Binding StopGenerationCommand}"
                            IsVisible="{Binding IsBusy}"
                            Margin="8,0,0,0"
                            ToolTip.Tip="停止生成">
                        <materialIcons:MaterialIcon Kind="Stop" Width="20" Height="20" />
                    </controls:RippleButton>

                    <controls:RippleButton Grid.Column="2"
                            Classes="Filled Icon"
                            Command="{Binding SendMessageCommand}"
                            IsVisible="{Binding !IsBusy}"
                            Margin="8,0,0,0"
                            ToolTip.Tip="发送 (Ctrl+Enter)">
                        <materialIcons:MaterialIcon Kind="Send" Width="20" Height="20" />
                    </controls:RippleButton>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
