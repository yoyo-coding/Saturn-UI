<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             xmlns:models="using:SaturnUI.Models"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:controls="using:SaturnUI.Controls"
             x:Class="SaturnUI.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource M3Surface}">
        <ScrollViewer Grid.Row="0"
                      Name="MessagesScroll"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <StackPanel Margin="28,28,28,160" Spacing="20">
                <Border Classes="Card Tonal"
                        Padding="24"
                        MaxWidth="780"
                        HorizontalAlignment="Center">
                    <StackPanel Spacing="8">
                        <TextBlock Text="开始一次新的探索"
                                   Classes="HeadlineSmall"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="输入问题、粘贴截图或拖入文件。Enter 发送，Ctrl+Enter 换行。"
                                   Classes="BodyMedium Muted"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:Message">
                            <Grid Margin="0,6">
                                <Border MaxWidth="820"
                                        HorizontalAlignment="{Binding Role, Converter={StaticResource RoleAlignmentConverter}}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsAssistant}">
                                            <Border Grid.Column="0"
                                                    Width="30" Height="30"
                                                    CornerRadius="16"
                                                    Background="{DynamicResource M3SecondaryContainer}">
                                                <TextBlock Text="AI" Classes="LabelSmall"
                                                           Foreground="{DynamicResource M3OnSecondaryContainer}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="Saturn Assistant"
                                                       Classes="LabelMedium Muted"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Classes="MessageBubble"
                                                Classes.User="{Binding IsUser}"
                                                Classes.Assistant="{Binding IsAssistant}"
                                                Background="{Binding Role, Converter={StaticResource RoleBackgroundConverter}}">
                                            <StackPanel Spacing="10">
                                                <TextBlock IsVisible="{Binding IsUser}"
                                                           Text="{Binding Content}"
                                                           TextWrapping="Wrap"
                                                           Classes="BodyLarge" />

                                                <md:MarkdownScrollViewer IsVisible="{Binding IsAssistant}"
                                                                         Markdown="{Binding Content}"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                         MaxWidth="780">
                                                    <md:MarkdownScrollViewer.Styles>
                                                        <Style Selector="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource M3OnSurface}" />
                                                        </Style>
                                                        <Style Selector="Border.CodeBlock">
                                                            <Setter Property="Background" Value="{DynamicResource M3CodeBackground}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource M3CodeBorder}" />
                                                            <Setter Property="CornerRadius" Value="4" />
                                                        </Style>
                                                        <Style Selector="Border.Blockquote">
                                                            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHigh}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource M3Primary}" />
                                                        </Style>
                                                    </md:MarkdownScrollViewer.Styles>
                                                </md:MarkdownScrollViewer>

                                                <Border IsVisible="{Binding IsImageAttachment}"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        BorderBrush="{DynamicResource M3OutlineVariant}"
                                                        BorderThickness="1"
                                                        MaxWidth="420"
                                                        MaxHeight="320"
                                                        HorizontalAlignment="Left">
                                                    <Image Source="{Binding AttachmentPath}" Stretch="Uniform" />
                                                </Border>

                                                <Border IsVisible="{Binding HasAttachment}"
                                                        Classes="AttachmentChip"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <materialIcons:MaterialIcon Kind="FileDocumentOutline"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource M3OnSurfaceVariant}" />
                                                        <TextBlock Text="{Binding AttachmentName}"
                                                                   Classes="BodySmall Muted"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock IsVisible="{Binding IsError}"
                                                           Text="{Binding ErrorMessage}"
                                                           Classes="BodySmall Error"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                   Classes="LabelSmall Muted"
                                                   HorizontalAlignment="{Binding Role, Converter={StaticResource RoleAlignmentConverter}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" VerticalAlignment="Bottom">
            <Border Height="44" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="1" Color="#CC000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Margin="28,0,28,24"
                    VerticalAlignment="Bottom"
                    Classes="Card Filled"
                    Padding="10"
                    CornerRadius="16"
                    BorderBrush="{DynamicResource M3OutlineVariant}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0"
                            IsVisible="{Binding PendingAttachmentName, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Classes="AttachmentChip"
                            Margin="6,4,6,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0"
                                                        Kind="FileDocumentOutline"
                                                        Width="18" Height="18"
                                                        Foreground="{DynamicResource M3OnSurfaceVariant}"
                                                        VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PendingAttachmentName}"
                                       Classes="BodySmall Muted"
                                       Margin="8,0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <controls:RippleButton Grid.Column="2"
                                    Classes="Icon"
                                    Command="{Binding ClearAttachmentCommand}"
                                    Padding="4"
                                    ToolTip.Tip="移除附件">
                                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                            </controls:RippleButton>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                        <TextBox Grid.Column="0"
                                 Classes="Flat"
                                 Text="{Binding InputText}"
                                 Watermark="输入消息，或拖入文件 / Ctrl+V 粘贴图片..."
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="48"
                                 MaxHeight="150"
                                 VerticalContentAlignment="Center"
                                 Padding="18,12"
                                 KeyDown="OnInputKeyDown" />

                        <controls:RippleButton Grid.Column="1"
                                Classes="Filled Icon"
                                Command="{Binding SendMessageCommand}"
                                IsVisible="{Binding !IsBusy}"
                                Margin="8,4,4,4"
                                ToolTip.Tip="发送 (Enter)">
                            <materialIcons:MaterialIcon Kind="Send" Width="20" Height="20" />
                        </controls:RippleButton>
                        <controls:RippleButton Grid.Column="1"
                                Classes="FilledTonal Icon"
                                Command="{Binding StopGenerationCommand}"
                                IsVisible="{Binding IsBusy}"
                                Margin="8,4,4,4"
                                ToolTip.Tip="停止生成">
                            <materialIcons:MaterialIcon Kind="Stop" Width="20" Height="20" />
                        </controls:RippleButton>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
