<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaturnUI.ViewModels"
        xmlns:controls="using:SaturnUI.Controls"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="SaturnUI.Views.LocalProviderWindow"
        x:DataType="vm:SettingsViewModel"
        Title="本地后端配置"
        Background="{DynamicResource M3Background}"
        Foreground="{DynamicResource M3OnSurface}"
        Width="540" Height="460"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="14">
        <Border Grid.Row="0" Classes="Card Filled" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="本地后端配置" Classes="HeadlineSmall" />
                        <TextBlock Text="用于连接 Saturn 本地推理服务，保留 HTTP、SSE、WebSocket 与 gRPC 协议选择。"
                                   Classes="BodyMedium Muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="HTTP 地址" Classes="LabelLarge" />
                        <TextBox Text="{Binding HttpBaseUrl}" Watermark="http://localhost:8000" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="gRPC 地址" Classes="LabelLarge" />
                        <TextBox Text="{Binding GrpcAddress}" Watermark="localhost:50051" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="通信协议" Classes="LabelLarge" />
                        <ComboBox SelectedItem="{Binding Protocol}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="HTTP" />
                            <ComboBoxItem Content="SSE" />
                            <ComboBoxItem Content="WebSocket" />
                            <ComboBoxItem Content="gRPC" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Padding="4,14,4,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <controls:RippleButton Classes="Outlined"
                        Click="OnCancelClick"
                        Padding="24,12">
                    <TextBlock Text="取消" />
                </controls:RippleButton>
                <controls:RippleButton Classes="Filled"
                        Click="OnSaveClick"
                        Padding="24,12">
                    <TextBlock Text="保存" />
                </controls:RippleButton>
            </StackPanel>
        </Border>
    </Grid>
</Window>
