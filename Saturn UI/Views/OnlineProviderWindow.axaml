<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaturnUI.ViewModels"
        xmlns:controls="using:SaturnUI.Controls"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="SaturnUI.Views.OnlineProviderWindow"
        x:DataType="vm:SettingsViewModel"
        Title="OpenAI 兼容配置"
        Background="{DynamicResource M3Background}"
        Foreground="{DynamicResource M3OnSurface}"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="14">
        <Border Grid.Row="0" Classes="Card Filled" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="OpenAI 兼容配置" Classes="HeadlineSmall" />
                        <TextBlock Text="支持 OpenAI、Azure OpenAI、vLLM、LM Studio 与其它兼容 /v1/chat/completions 的服务。"
                                   Classes="BodyMedium Muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="API Key" Classes="LabelLarge" />
                        <TextBox Text="{Binding OpenAiApiKey}" Watermark="sk-..." />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="模型" Classes="LabelLarge" />
                        <TextBox Text="{Binding OpenAiModel}" Watermark="gpt-4o-mini" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Base URL" Classes="LabelLarge" />
                        <TextBox Text="{Binding OpenAiBaseUrl}" Watermark="https://api.openai.com/v1" />
                    </StackPanel>

                    <Border Classes="Card Tonal" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Temperature" Classes="LabelLarge" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding OpenAiTemperature, StringFormat='{}{0:F1}'}"
                                           Classes="BodySmall Muted" />
                            </Grid>
                            <Slider Value="{Binding OpenAiTemperature}"
                                    Minimum="0"
                                    Maximum="2"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Max Tokens" Classes="LabelLarge" />
                        <NumericUpDown Value="{Binding OpenAiMaxTokens}"
                                       Minimum="1"
                                       Maximum="128000"
                                       HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Padding="4,14,4,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <controls:RippleButton Classes="Outlined"
                        Click="OnCancelClick"
                        Padding="24,12">
                    <TextBlock Text="取消" />
                </controls:RippleButton>
                <controls:RippleButton Classes="Filled"
                        Click="OnSaveClick"
                        Padding="24,12">
                    <TextBlock Text="保存" />
                </controls:RippleButton>
            </StackPanel>
        </Border>
    </Grid>
</Window>
