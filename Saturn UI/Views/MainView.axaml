<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             x:Class="SaturnUI.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource M3Background}" Margin="12">
        <Border Grid.Row="0" Classes="TopAppBar" CornerRadius="{StaticResource M3ShapeLarge}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Chat" Command="{Binding SwitchToChatModeCommand}" />
                <Button Content="Coding" Command="{Binding SwitchToCodingModeCommand}" />
                <TextBlock Text="{Binding ActiveStatusText}" Classes="BodySmall Muted" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentWorkspace}" />
    </Grid>
</UserControl>
