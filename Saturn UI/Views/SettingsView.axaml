<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             xmlns:services="using:SaturnUI.Services"
             xmlns:controls="using:SaturnUI.Controls"
             x:Class="SaturnUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource M3Background}">
        <StackPanel Margin="24,16" Spacing="16" MaxWidth="600">
            <TextBlock Text="后端配置"
                       Classes="TitleLarge" />

            <StackPanel Spacing="8">
                <TextBlock Text="HTTP 地址"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <TextBox Text="{Binding HttpBaseUrl}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="gRPC 地址"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <TextBox Text="{Binding GrpcAddress}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="通信协议"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <ComboBox SelectedItem="{Binding Protocol}"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="HTTP" />
                    <ComboBoxItem Content="SSE" />
                    <ComboBoxItem Content="WebSocket" />
                    <ComboBoxItem Content="gRPC" />
                    <ComboBoxItem Content="OpenAI" />
                </ComboBox>
            </StackPanel>

            <Border Classes="Divider" Margin="0,8" />

            <TextBlock Text="OpenAI 配置"
                       Classes="TitleLarge" />

            <StackPanel Spacing="8">
                <TextBlock Text="API Key"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <TextBox Text="{Binding OpenAiApiKey}"
                         Watermark="sk-..." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="模型"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <TextBox Text="{Binding OpenAiModel}"
                         Watermark="gpt-3.5-turbo" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Base URL"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <TextBox Text="{Binding OpenAiBaseUrl}"
                         Watermark="https://api.openai.com/v1" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Temperature"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <Slider Value="{Binding OpenAiTemperature}"
                        Minimum="0"
                        Maximum="2"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True" />
                <TextBlock Text="{Binding OpenAiTemperature, StringFormat='{}{0:F1}'}"
                           Classes="BodySmall"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Max Tokens"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <NumericUpDown Value="{Binding OpenAiMaxTokens}"
                               Minimum="1"
                               Maximum="128000"
                               HorizontalAlignment="Stretch" />
            </StackPanel>

            <Border Classes="Divider" Margin="0,8" />

            <TextBlock Text="外观"
                       Classes="TitleLarge" />

            <StackPanel Spacing="8">
                <TextBlock Text="字体大小"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <Slider Value="{Binding FontSize}"
                        Minimum="10"
                        Maximum="24"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True" />
                <TextBlock Text="{Binding FontSize, StringFormat='{}{0} px'}"
                           Classes="BodySmall"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="主题"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <ComboBox ItemsSource="{Binding AvailableThemes}"
                          SelectedItem="{Binding Theme}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding Converter={x:Static services:ThemeNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="性能模式"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}" />
                <ToggleSwitch IsChecked="{Binding PerformanceMode}"
                              OffContent="关闭"
                              OnContent="开启" />
            </StackPanel>

            <Border Classes="Divider" Margin="0,8" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <controls:RippleButton Classes="Filled"
                        Command="{Binding SaveSettingsCommand}"
                        Padding="24,10">
                    <TextBlock Text="保存设置" />
                </controls:RippleButton>
                <controls:RippleButton Classes="Outlined"
                        Command="{Binding ResetSettingsCommand}"
                        Padding="24,10">
                    <TextBlock Text="恢复默认" />
                </controls:RippleButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
