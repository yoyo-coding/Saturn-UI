<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaturnUI.ViewModels"
             xmlns:controls="using:SaturnUI.Controls"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="SaturnUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource M3Background}">
        <StackPanel Margin="22" Spacing="18" MaxWidth="720">
            <Border Classes="Card Tonal" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="AI 提供商" Classes="TitleLarge" />
                    <TextBlock Text="选择本地后端或 OpenAI 兼容服务，并在独立面板中维护连接参数。"
                               Classes="BodyMedium Muted" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding AvailableProviders}"
                              SelectedItem="{Binding Provider}"
                              HorizontalAlignment="Stretch" />
                    <controls:RippleButton Classes="Filled"
                            Command="{Binding OpenProviderConfigCommand}"
                            Padding="18,12"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ProviderConfigButtonText}"
                                       Classes="LabelLarge"
                                       VerticalAlignment="Center" />
                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Cog" Width="20" Height="20" />
                        </Grid>
                    </controls:RippleButton>
                </StackPanel>
            </Border>

            <Border Classes="Card Filled" Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="当前配置" Classes="LabelLarge Primary" />
                    <TextBlock Text="{Binding CurrentProviderStatus}"
                               Classes="BodyMedium"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="Card Filled" Padding="22">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="外观" Classes="TitleLarge" />
                        <TextBlock Text="使用单一种子色生成整套 Material 3 配色：主色、容器色、辅助色、表面色与状态色会自动联动。"
                                   Classes="BodySmall Muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="字体大小" Classes="LabelLarge" />
                        <Slider Value="{Binding FontSize}"
                                Minimum="10"
                                Maximum="24"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding FontSize, StringFormat='{}{0} px'}"
                                   Classes="BodySmall Muted" />
                    </StackPanel>

                    <Border Classes="Card Tonal" Padding="16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="动态取色板" Classes="LabelLarge" />
                                    <TextBlock Text="从预设中选一个颜色会立即保存并重算主题；也可以输入 HEX 色值后点击保存。"
                                               Classes="BodySmall Muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="16"
                                        Background="{Binding AccentPreviewBrush}"
                                        BorderBrush="{DynamicResource M3OutlineVariant}"
                                        BorderThickness="1" />
                            </Grid>

                            <ListBox ItemsSource="{Binding AccentColorOptions}"
                                     SelectedItem="{Binding SelectedAccentOption}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     HorizontalAlignment="Stretch">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColorPaletteOption">
                                        <StackPanel Margin="0,0,10,10" Spacing="6" Width="66">
                                            <Border Width="44"
                                                    Height="44"
                                                    CornerRadius="16"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="{DynamicResource M3OutlineVariant}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}"
                                                       Classes="BodySmall"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0"
                                           Text="种子色"
                                           Classes="LabelLarge"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="#6750A4"
                                         HorizontalAlignment="Stretch" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding NormalizedAccentColor, StringFormat='当前规范色值：{0}'}"
                                           Classes="BodySmall Muted"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding UseLightTheme}"
                                              OffContent="深色"
                                              OnContent="浅色"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" Padding="12" CornerRadius="16" Background="{DynamicResource M3PrimaryContainer}">
                                    <TextBlock Text="Primary" Foreground="{DynamicResource M3OnPrimaryContainer}" Classes="LabelMedium" TextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Padding="12" CornerRadius="16" Background="{DynamicResource M3SecondaryContainer}">
                                    <TextBlock Text="Secondary" Foreground="{DynamicResource M3OnSecondaryContainer}" Classes="LabelMedium" TextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Padding="12" CornerRadius="16" Background="{DynamicResource M3TertiaryContainer}">
                                    <TextBlock Text="Tertiary" Foreground="{DynamicResource M3OnTertiaryContainer}" Classes="LabelMedium" TextAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card Tonal" Padding="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="性能模式" Classes="LabelLarge" />
                                <TextBlock Text="降低部分视觉开销，适合长会话或低功耗设备。"
                                           Classes="BodySmall Muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding PerformanceMode}"
                                          OffContent="关"
                                          OnContent="开"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <controls:RippleButton Classes="Outlined"
                        Command="{Binding ResetSettingsCommand}"
                        Padding="24,12">
                    <TextBlock Text="恢复默认" />
                </controls:RippleButton>
                <controls:RippleButton Classes="Filled"
                        Command="{Binding SaveSettingsCommand}"
                        Padding="24,12">
                    <TextBlock Text="保存设置" />
                </controls:RippleButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
