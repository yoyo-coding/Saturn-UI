<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SaturnUI"
             xmlns:converters="using:SaturnUI.Converters"
             x:Class="SaturnUI.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SaturnUI/Themes/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:RoleAlignmentConverter x:Key="RoleAlignmentConverter" />
            <converters:RoleBackgroundConverter x:Key="RoleBackgroundConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SaturnUI/Themes/ThemeStyles.axaml" />
    </Application.Styles>
</Application>
