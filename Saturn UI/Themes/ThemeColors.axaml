<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default fallback colors. Runtime colors are generated by DynamicColorPalette from the user-selected seed color. -->
    <SolidColorBrush x:Key="M3Primary" Color="#D0BCFF" />
    <SolidColorBrush x:Key="M3OnPrimary" Color="#381E72" />
    <SolidColorBrush x:Key="M3PrimaryContainer" Color="#4F378B" />
    <SolidColorBrush x:Key="M3OnPrimaryContainer" Color="#EADDFF" />

    <SolidColorBrush x:Key="M3Secondary" Color="#CCC2DC" />
    <SolidColorBrush x:Key="M3OnSecondary" Color="#332D41" />
    <SolidColorBrush x:Key="M3SecondaryContainer" Color="#4A4458" />
    <SolidColorBrush x:Key="M3OnSecondaryContainer" Color="#E8DEF8" />

    <SolidColorBrush x:Key="M3Tertiary" Color="#EFB8C8" />
    <SolidColorBrush x:Key="M3OnTertiary" Color="#492532" />
    <SolidColorBrush x:Key="M3TertiaryContainer" Color="#633B48" />
    <SolidColorBrush x:Key="M3OnTertiaryContainer" Color="#FFD8E4" />

    <SolidColorBrush x:Key="M3Error" Color="#F2B8B5" />
    <SolidColorBrush x:Key="M3OnError" Color="#601410" />
    <SolidColorBrush x:Key="M3ErrorContainer" Color="#8C1D18" />
    <SolidColorBrush x:Key="M3OnErrorContainer" Color="#F9DEDC" />

    <SolidColorBrush x:Key="M3Background" Color="#141218" />
    <SolidColorBrush x:Key="M3OnBackground" Color="#E6E0E9" />
    <SolidColorBrush x:Key="M3Surface" Color="#141218" />
    <SolidColorBrush x:Key="M3OnSurface" Color="#E6E0E9" />
    <SolidColorBrush x:Key="M3SurfaceVariant" Color="#49454F" />
    <SolidColorBrush x:Key="M3OnSurfaceVariant" Color="#CAC4D0" />
    <SolidColorBrush x:Key="M3SurfaceContainerLowest" Color="#0F0D13" />
    <SolidColorBrush x:Key="M3SurfaceContainerLow" Color="#1D1B20" />
    <SolidColorBrush x:Key="M3SurfaceContainer" Color="#211F26" />
    <SolidColorBrush x:Key="M3SurfaceContainerHigh" Color="#2B2930" />
    <SolidColorBrush x:Key="M3SurfaceContainerHighest" Color="#36343B" />

    <SolidColorBrush x:Key="M3Outline" Color="#938F99" />
    <SolidColorBrush x:Key="M3OutlineVariant" Color="#49454F" />
    <SolidColorBrush x:Key="M3InverseSurface" Color="#E6E0E9" />
    <SolidColorBrush x:Key="M3InverseOnSurface" Color="#322F35" />
    <SolidColorBrush x:Key="M3InversePrimary" Color="#6750A4" />

    <SolidColorBrush x:Key="M3UserBubble" Color="#4F378B" />
    <SolidColorBrush x:Key="M3OnUserBubble" Color="#EADDFF" />
    <SolidColorBrush x:Key="M3AiBubble" Color="#211F26" />
    <SolidColorBrush x:Key="M3OnAiBubble" Color="#E6E0E9" />
    <SolidColorBrush x:Key="M3CodeBackground" Color="#0F0D13" />
    <SolidColorBrush x:Key="M3CodeBorder" Color="#49454F" />
    <SolidColorBrush x:Key="M3InlineCodeBackground" Color="#36343B" />

    <SolidColorBrush x:Key="M3HoverOverlay" Color="#1FEADDFF" />
    <SolidColorBrush x:Key="M3FocusOverlay" Color="#29EADDFF" />
    <SolidColorBrush x:Key="M3FilledHover" Color="#C4AFFF" />
    <SolidColorBrush x:Key="M3FilledPressed" Color="#B99FFF" />
    <SolidColorBrush x:Key="M3FilledTonalHover" Color="#5B4296" />
    <SolidColorBrush x:Key="M3FilledTonalPressed" Color="#654BA0" />
    <SolidColorBrush x:Key="M3Scrim" Color="#000000" />
    <SolidColorBrush x:Key="M3Shadow" Color="#000000" />
</ResourceDictionary>
