        <SolidColorBrush x:Key="M3SurfaceContainerLowest" Color="#FFFFFF" />
        <SolidColorBrush x:Key="M3SurfaceContainerLow" Color="#F3F4F8" />
        <SolidColorBrush x:Key="M3SurfaceContainer" Color="#EDEDF1" />
        <SolidColorBrush x:Key="M3SurfaceContainerHigh" Color="#E7E8EB" />
        <SolidColorBrush x:Key="M3SurfaceContainerHighest" Color="#E1E2E5" />
        <SolidColorBrush x:Key="M3Outline" Color="#74777F" />
        <SolidColorBrush x:Key="M3OutlineVariant" Color="#C4C6D0" />
        <SolidColorBrush x:Key="M3InverseSurface" Color="#2E3035" />
        <SolidColorBrush x:Key="M3InverseOnSurface" Color="#F1F0F4" />
        <SolidColorBrush x:Key="M3InversePrimary" Color="#ADC6FF" />
        <SolidColorBrush x:Key="M3Scrim" Color="#000000" />
        <SolidColorBrush x:Key="M3Shadow" Color="#000000" />
        <SolidColorBrush x:Key="M3UserBubble" Color="#D8E2FF" />
        <SolidColorBrush x:Key="M3OnUserBubble" Color="#001947" />
        <SolidColorBrush x:Key="M3AiBubble" Color="#EDEDF1" />
        <SolidColorBrush x:Key="M3OnAiBubble" Color="#1A1B21" />
        <SolidColorBrush x:Key="M3CodeBackground" Color="#EDEDF1" />
        <SolidColorBrush x:Key="M3CodeBorder" Color="#C4C6D0" />
        <SolidColorBrush x:Key="M3InlineCodeBackground" Color="#E1E2EC" />
        <!-- Hover/Focus 状态层 -->
        <SolidColorBrush x:Key="M3HoverOverlay" Color="#1F1A56DB" />
        <SolidColorBrush x:Key="M3FocusOverlay" Color="#1F001947" />
    </ResourceDictionary>

