        <SolidColorBrush x:Key="M3FocusOverlay" Color="#1FE3DFFF" />
        <!-- Filled Button hover/pressed -->
        <SolidColorBrush x:Key="M3FilledHover" Color="#B6B3F3" />
        <SolidColorBrush x:Key="M3FilledPressed" Color="#B0ACED" />
        <!-- FilledTonal/Tonal/FAB hover/pressed -->
        <SolidColorBrush x:Key="M3FilledTonalHover" Color="#413D86" />
        <SolidColorBrush x:Key="M3FilledTonalPressed" Color="#48448C" />
    </ResourceDictionary>
</ResourceDictionary>
