        <SolidColorBrush x:Key="LynCodeBorderBrush" Color="#501B2E" />
        <SolidColorBrush x:Key="LynInlineCodeBackgroundBrush" Color="#501B2E" />
        <SolidColorBrush x:Key="LynSelectionBrush" Color="#F43F5E40" />
