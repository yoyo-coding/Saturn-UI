    <ResourceDictionary x:Key="StarryBlue">
        <SolidColorBrush x:Key="LynBackgroundBrush" Color="#0B1120" />
        <SolidColorBrush x:Key="LynSurfaceBrush" Color="#151E32" />
        <SolidColorBrush x:Key="LynPrimaryBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="LynAccentBrush" Color="#C084FC" />
        <SolidColorBrush x:Key="LynTextBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="LynSubTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="LynBorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="LynUserMessageBrush" Color="#0284C7" />
        <SolidColorBrush x:Key="LynAiMessageBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="LynError" Color="#EF4444" />
        <SolidColorBrush x:Key="LynCodeBackgroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="LynCodeBorderBrush" Color="#1E293B" />
