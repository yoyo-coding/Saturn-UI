<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================ -->
    <!-- Saturn UI 主题颜色定义 - Material 3 设计令牌        -->
    <!-- 每个主题包含 M3 完整令牌,用于组件着色                -->
    <!-- 参考: https://m3.material.io/styles/color/system -->
    <!-- ============================================ -->

    <!-- 主题:深空黑 (默认) -->
    <ResourceDictionary x:Key="DeepSpace">
        <!-- Primary -->
        <SolidColorBrush x:Key="M3Primary" Color="#A8C7FA" />
        <SolidColorBrush x:Key="M3OnPrimary" Color="#062E6F" />
        <SolidColorBrush x:Key="M3PrimaryContainer" Color="#284777" />
        <SolidColorBrush x:Key="M3OnPrimaryContainer" Color="#D3E3FD" />
        <!-- Secondary -->
        <SolidColorBrush x:Key="M3Secondary" Color="#BEC6DC" />
        <SolidColorBrush x:Key="M3OnSecondary" Color="#283044" />
        <SolidColorBrush x:Key="M3SecondaryContainer" Color="#3E4759" />
        <SolidColorBrush x:Key="M3OnSecondaryContainer" Color="#DAE2F9" />
        <!-- Tertiary -->
        <SolidColorBrush x:Key="M3Tertiary" Color="#DEBCDF" />
        <SolidColorBrush x:Key="M3OnTertiary" Color="#3F2844" />
        <SolidColorBrush x:Key="M3TertiaryContainer" Color="#583E5C" />
        <SolidColorBrush x:Key="M3OnTertiaryContainer" Color="#FAD8FC" />
        <!-- Error -->
        <SolidColorBrush x:Key="M3Error" Color="#F2B8B5" />
        <SolidColorBrush x:Key="M3OnError" Color="#601410" />
        <SolidColorBrush x:Key="M3ErrorContainer" Color="#8C1D18" />
        <SolidColorBrush x:Key="M3OnErrorContainer" Color="#F9DEDC" />
        <!-- Surface & Background -->
        <SolidColorBrush x:Key="M3Background" Color="#0F1115" />
        <SolidColorBrush x:Key="M3OnBackground" Color="#E3E2E6" />
        <SolidColorBrush x:Key="M3Surface" Color="#0F1115" />
        <SolidColorBrush x:Key="M3OnSurface" Color="#E3E2E6" />
        <SolidColorBrush x:Key="M3SurfaceVariant" Color="#44474F" />
        <SolidColorBrush x:Key="M3OnSurfaceVariant" Color="#C4C6D0" />
        <SolidColorBrush x:Key="M3SurfaceContainerLowest" Color="#0A0C10" />
        <SolidColorBrush x:Key="M3SurfaceContainerLow" Color="#181B20" />
        <SolidColorBrush x:Key="M3SurfaceContainer" Color="#1C1F25" />
        <SolidColorBrush x:Key="M3SurfaceContainerHigh" Color="#262A30" />
        <SolidColorBrush x:Key="M3SurfaceContainerHighest" Color="#31353B" />
        <!-- Outline -->
        <SolidColorBrush x:Key="M3Outline" Color="#8E9099" />
        <SolidColorBrush x:Key="M3OutlineVariant" Color="#44474F" />
        <!-- Inverse -->
        <SolidColorBrush x:Key="M3InverseSurface" Color="#E3E2E6" />
        <SolidColorBrush x:Key="M3InverseOnSurface" Color="#2E3035" />
        <SolidColorBrush x:Key="M3InversePrimary" Color="#3B5EA9" />
        <!-- Misc -->
        <SolidColorBrush x:Key="M3Scrim" Color="#000000" />
        <SolidColorBrush x:Key="M3Shadow" Color="#000000" />
        <!-- 用户/AI 消息色 -->
        <SolidColorBrush x:Key="M3UserBubble" Color="#284777" />
        <SolidColorBrush x:Key="M3OnUserBubble" Color="#D3E3FD" />
        <SolidColorBrush x:Key="M3AiBubble" Color="#262A30" />
        <SolidColorBrush x:Key="M3OnAiBubble" Color="#E3E2E6" />
        <!-- 代码块 -->
        <SolidColorBrush x:Key="M3CodeBackground" Color="#0A0C10" />
        <SolidColorBrush x:Key="M3CodeBorder" Color="#44474F" />
        <SolidColorBrush x:Key="M3InlineCodeBackground" Color="#31353B" />
        <!-- Hover/Focus 状态层(主色叠加 12% alpha,仅作用于背景) -->
        <SolidColorBrush x:Key="M3HoverOverlay" Color="#1FA8C7FA" />
        <SolidColorBrush x:Key="M3FocusOverlay" Color="#1FD3E3FD" />
    </ResourceDictionary>

    <!-- 主题:极昼白 (浅色) -->
