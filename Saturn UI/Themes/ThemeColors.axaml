    <!-- 主题定义：午夜靛蓝 -->
    <ResourceDictionary x:Key="MidnightIndigo">
        <SolidColorBrush x:Key="LynBackgroundBrush" Color="#0B0C1E" />
        <SolidColorBrush x:Key="LynSurfaceBrush" Color="#151733" />
        <SolidColorBrush x:Key="LynPrimaryBrush" Color="#6366F1" />
