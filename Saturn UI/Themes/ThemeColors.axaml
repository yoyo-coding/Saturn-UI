        <SolidColorBrush x:Key="LynAiMessageBrush" Color="#1E2147" />
        <SolidColorBrush x:Key="LynError" Color="#EF4444" />
        <SolidColorBrush x:Key="LynCodeBackgroundBrush" Color="#0E1026" />
        <SolidColorBrush x:Key="LynCodeBorderBrush" Color="#262955" />
        <SolidColorBrush x:Key="LynInlineCodeBackgroundBrush" Color="#262955" />
