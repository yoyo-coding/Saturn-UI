<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================ -->
    <!-- Saturn UI 主题颜色定义                            -->
    <!-- 每个主题包含 15 个颜色变量，用于 UI 各元素着色   -->
    <!-- ============================================ -->

    <!-- 主题定义：深空黑 (默认) -->
    <ResourceDictionary x:Key="DeepSpace">
        <SolidColorBrush x:Key="LynBackgroundBrush" Color="#0A0A0C" />
        <SolidColorBrush x:Key="LynSurfaceBrush" Color="#1A1A1E" />
        <SolidColorBrush x:Key="LynPrimaryBrush" Color="#4FACFE" />
        <SolidColorBrush x:Key="LynAccentBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="LynTextBrush" Color="#E2E2E2" />
        <SolidColorBrush x:Key="LynSubTextBrush" Color="#8B8B94" />
        <SolidColorBrush x:Key="LynBorderBrush" Color="#2A2A30" />
        <SolidColorBrush x:Key="LynUserMessageBrush" Color="#1D3B5C" />
        <SolidColorBrush x:Key="LynAiMessageBrush" Color="#222228" />
        <SolidColorBrush x:Key="LynError" Color="#EF4444" />
        <SolidColorBrush x:Key="LynCodeBackgroundBrush" Color="#141418" />
        <SolidColorBrush x:Key="LynCodeBorderBrush" Color="#2A2A30" />
        <SolidColorBrush x:Key="LynInlineCodeBackgroundBrush" Color="#2A2A30" />
        <SolidColorBrush x:Key="LynSelectionBrush" Color="#4FACFE40" />
        <SolidColorBrush x:Key="LynHoverBrush" Color="#FFFFFF1A" />
        <SolidColorBrush x:Key="LynPressedBrush" Color="#FFFFFF33" />
        <SolidColorBrush x:Key="LynButtonTextBrush" Color="#FFFFFF" />
    </ResourceDictionary>

    <!-- 主题定义：极昼白 -->
    <ResourceDictionary x:Key="Daylight">
        <SolidColorBrush x:Key="LynBackgroundBrush" Color="#F8F9FA" />
        <SolidColorBrush x:Key="LynSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LynPrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="LynAccentBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="LynTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="LynSubTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="LynBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="LynUserMessageBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="LynAiMessageBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="LynError" Color="#DC2626" />
        <SolidColorBrush x:Key="LynCodeBackgroundBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="LynCodeBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="LynInlineCodeBackgroundBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="LynSelectionBrush" Color="#BFDBFE" />
        <SolidColorBrush x:Key="LynHoverBrush" Color="#0000000D" />
        <SolidColorBrush x:Key="LynPressedBrush" Color="#0000001A" />
        <SolidColorBrush x:Key="LynButtonTextBrush" Color="#FFFFFF" />
    </ResourceDictionary>

