<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="using:SaturnUI.Controls">

    <Styles.Resources>
        <Thickness x:Key="M3PagePadding">24</Thickness>
        <Thickness x:Key="M3CardPadding">20</Thickness>
        <sys:Double x:Key="M3FontDisplaySmall">36</sys:Double>
        <sys:Double x:Key="M3FontHeadlineLarge">32</sys:Double>
        <sys:Double x:Key="M3FontHeadlineMedium">28</sys:Double>
        <sys:Double x:Key="M3FontHeadlineSmall">24</sys:Double>
        <sys:Double x:Key="M3FontTitleLarge">22</sys:Double>
        <sys:Double x:Key="M3FontTitleMedium">16</sys:Double>
        <sys:Double x:Key="M3FontTitleSmall">14</sys:Double>
        <sys:Double x:Key="M3FontBodyLarge">16</sys:Double>
        <sys:Double x:Key="M3FontBodyMedium">14</sys:Double>
        <sys:Double x:Key="M3FontBodySmall">12</sys:Double>
        <sys:Double x:Key="M3FontLabelLarge">14</sys:Double>
        <sys:Double x:Key="M3FontLabelMedium">12</sys:Double>
        <sys:Double x:Key="M3FontLabelSmall">11</sys:Double>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource M3Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurface}" />
        <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei UI" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei UI" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.DisplaySmall">
        <Setter Property="FontSize" Value="{StaticResource M3FontDisplaySmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="44" />
    </Style>
    <Style Selector="TextBlock.HeadlineLarge">
        <Setter Property="FontSize" Value="{StaticResource M3FontHeadlineLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style Selector="TextBlock.HeadlineMedium">
        <Setter Property="FontSize" Value="{StaticResource M3FontHeadlineMedium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="36" />
    </Style>
    <Style Selector="TextBlock.HeadlineSmall">
        <Setter Property="FontSize" Value="{StaticResource M3FontHeadlineSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="32" />
    </Style>
    <Style Selector="TextBlock.TitleLarge">
        <Setter Property="FontSize" Value="{StaticResource M3FontTitleLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.TitleMedium">
        <Setter Property="FontSize" Value="{StaticResource M3FontTitleMedium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.TitleSmall">
        <Setter Property="FontSize" Value="{StaticResource M3FontTitleSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.BodyLarge">
        <Setter Property="FontSize" Value="{StaticResource M3FontBodyLarge}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.BodyMedium">
        <Setter Property="FontSize" Value="{StaticResource M3FontBodyMedium}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.BodySmall">
        <Setter Property="FontSize" Value="{StaticResource M3FontBodySmall}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style Selector="TextBlock.LabelLarge">
        <Setter Property="FontSize" Value="{StaticResource M3FontLabelLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.LabelMedium">
        <Setter Property="FontSize" Value="{StaticResource M3FontLabelMedium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.LabelSmall">
        <Setter Property="FontSize" Value="{StaticResource M3FontLabelSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.Muted">
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariant}" />
    </Style>
    <Style Selector="TextBlock.Primary">
        <Setter Property="Foreground" Value="{DynamicResource M3Primary}" />
    </Style>
    <Style Selector="TextBlock.Error">
        <Setter Property="Foreground" Value="{DynamicResource M3Error}" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.AppSurface">
        <Setter Property="Background" Value="{DynamicResource M3Surface}" />
    </Style>
    <Style Selector="Border.NavigationRail">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariant}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.TopAppBar">
        <Setter Property="Background" Value="{DynamicResource M3Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariant}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinHeight" Value="72" />
    </Style>
    <Style Selector="Border.TitleBar">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariant}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.Card.Filled">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHigh}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.Card.Tonal">
        <Setter Property="Background" Value="{DynamicResource M3SecondaryContainer}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource M3OutlineVariant}" />
    </Style>
    <Style Selector="Border.Pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHigh}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button, controls|RippleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Filled, controls|RippleButton.Filled">
        <Setter Property="Background" Value="{DynamicResource M3Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnPrimary}" />
    </Style>
    <Style Selector="Button.Filled:pointerover /template/ ContentPresenter, controls|RippleButton.Filled:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3FilledHover}" />
    </Style>
    <Style Selector="Button.FilledTonal, Button.Tonal, controls|RippleButton.FilledTonal, controls|RippleButton.Tonal">
        <Setter Property="Background" Value="{DynamicResource M3SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainer}" />
    </Style>
    <Style Selector="Button.Outlined, controls|RippleButton.Outlined">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3Outline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.Text, controls|RippleButton.Text">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource M3Primary}" />
    </Style>
    <Style Selector="Button.Icon, controls|RippleButton.Icon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.WindowControl, controls|RippleButton.WindowControl">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariant}" />
    </Style>
    <Style Selector="Button.WindowControl:pointerover, controls|RippleButton.WindowControl:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurface}" />
    </Style>
    <Style Selector="Button.WindowClose:pointerover, controls|RippleButton.WindowClose:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource M3OnErrorContainer}" />
    </Style>
    <Style Selector="Button.WindowClose:pointerover /template/ ContentPresenter, controls|RippleButton.WindowClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource M3ErrorContainer}" />
    </Style>
    <Style Selector="Button.Fab, controls|RippleButton.Fab">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{DynamicResource M3PrimaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainer}" />
    </Style>

    <!-- Input controls -->
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHigh}" />
        <Setter Property="Foreground" Value="{DynamicResource M3OnSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource M3Primary}" />
    </Style>
    <Style Selector="TextBox.Flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource M3Primary}" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="开" />
        <Setter Property="OffContent" Value="关" />
    </Style>

    <!-- Lists / messages -->
    <Style Selector="controls|RippleSelectableItem.SessionItem">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="HoverBackground" Value="{DynamicResource M3HoverOverlay}" />
        <Setter Property="SelectedBackground" Value="{DynamicResource M3SecondaryContainer}" />
        <Setter Property="SelectedHoverBackground" Value="{DynamicResource M3FilledTonalHover}" />
        <Setter Property="RippleBrush" Value="{DynamicResource M3Primary}" />
    </Style>
    <Style Selector="Border.MessageBubble">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MaxWidth" Value="820" />
    </Style>
    <Style Selector="Border.MessageBubble.User">
        <Setter Property="Background" Value="{DynamicResource M3UserBubble}" />
    </Style>
    <Style Selector="Border.MessageBubble.Assistant">
        <Setter Property="Background" Value="{DynamicResource M3AiBubble}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.AttachmentChip">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighest}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
